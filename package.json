{
  "name": "prepmind",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "npm --prefix app run dev",
    "build": "npm --prefix app run build",
    "typecheck": "npm --prefix app run typecheck",
    "test": "node test/api-test.mjs",
    "test:api": "node test/api-test.mjs",
    "test:db": "node test/db-auth-test.mjs",
    "test:rag": "node test/rag-test.mjs",
    "test:notebook": "node test/notebook-rag-test.mjs",
    "test:e2e-pdf": "node test/e2e-real-pdf-test.mjs",
    "test:all": "node test/api-test.mjs && node test/db-auth-test.mjs && node test/rag-test.mjs && node test/notebook-rag-test.mjs && node test/e2e-real-pdf-test.mjs",
    "server": "node server/server.js",
