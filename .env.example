# ==============================================================================
# PrepMind AI — Environment Variables Template
# ==============================================================================
# Copy this file to .env for local development.
# In production (Vercel), configure these in Project Settings -> Environment Variables.
# NEVER commit .env or real secret keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server-Side AI Provider Cascade (Serverless & Backend Only)
# ------------------------------------------------------------------------------
# Primary Hosted Provider: Groq Cloud (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Secondary High-Performance Failover: NVIDIA NIM (https://build.nvidia.com/)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Tertiary Failover & RAG Embeddings: Google Gemini (https://aistudio.google.com/app/apikey)
# NOTE: Required on the server for 768-dim vector embeddings in production RAG.
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-2.5-flash

# ------------------------------------------------------------------------------
# 2. Supabase Cloud Database & Authentication (Optional / Resilient Fallback)
# ------------------------------------------------------------------------------
# If omitted or left as placeholder, PrepMind runs automatically in offline
# resilient guest mode with user-scoped local storage persistence.
#
# Client-side (Public/Vite-accessible via envPrefix):
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key

# Server-side (Private/Serverless functions & Express):
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_public_anon_or_service_key

# ------------------------------------------------------------------------------
# 3. Local Development & Express Server Configuration (Optional)
# ------------------------------------------------------------------------------
PORT=5000
API_TOKEN=your_secure_bearer_token

# Optional frontend client overrides:
# Leave VITE_API_URL empty on Vercel to use relative /api rewrites.
VITE_API_URL=
VITE_API_TOKEN=
