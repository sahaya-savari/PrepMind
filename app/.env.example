# PrepMind Frontend Environment Variables (Vite)
# NOTE: Leave VITE_API_URL empty when deploying to Vercel so the frontend
# automatically uses the built-in relative serverless endpoint (/api/ai).
VITE_API_URL=
VITE_API_TOKEN=

# Supabase PostgreSQL Database & Auth (Optional)
# If provided, the app syncs auth & queries with your cloud Supabase project.
# If omitted, the app runs automatically with resilient offline / local storage database mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_KEY=

# Optional Feature Flags
VITE_ENABLE_STREAMING=true
VITE_ENABLE_PRACTICE_MODE=true
VITE_DEBUG_MODE=false
