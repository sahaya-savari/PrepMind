# Express Backend Server Environment Variables
PORT=5000
API_TOKEN=your_secure_bearer_token

# AI Providers (Used by server and /api/ai serverless function)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-2.5-flash
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Supabase PostgreSQL (Optional - runs in offline fallback mode if unset)
SUPABASE_URL=
SUPABASE_KEY=
