# AI Providers (Set on Vercel / server environment)
# Groq Cloud is free: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Google Gemini (Optional fallback)
GEMINI_API_KEY=

# NVIDIA NIM (Optional high-performance provider)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Supabase Database & Auth (Optional - runs in offline/guest mode if unset)
SUPABASE_URL=
SUPABASE_KEY=

# Local Server Configuration
PORT=5000
API_TOKEN=
