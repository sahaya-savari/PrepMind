# PrepMind AI Root Environment Variables Template
# Set these in your Vercel Project Settings (Settings -> Environment Variables)
# or in your local .env for local development.

# --- AI Provider API Keys ---
# Groq Cloud (Primary): https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# NVIDIA NIM (High Performance Failover): https://build.nvidia.com/
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Google Gemini (Tertiary Fallback): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=models/gemini-2.5-flash

# --- Supabase Database & Auth (Optional) ---
# Platform runs gracefully in offline / local-storage fallback mode if unset
SUPABASE_URL=
SUPABASE_KEY=

# --- Local Backend Configuration ---
PORT=5000
API_TOKEN=your_secure_bearer_token
